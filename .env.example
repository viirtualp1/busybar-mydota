# USB: BUSY_ADDR=10.0.4.20, leave token and password empty.
# Wi-Fi: BUSY_ADDR=<Bar LAN IP>, BUSY_HTTP_PASSWORD=<HTTP Access password>, leave BUSY_TOKEN empty.
# Cloud: BUSY_ADDR=https://api.busy.app + BUSY_TOKEN.
BUSY_ADDR=10.0.4.20
BUSY_TOKEN=
BUSY_HTTP_PASSWORD=

# Where Dota 2 posts its Game State Integration packets. Change the port only if
# something else already owns it, and re-run `npm run gsi:install` afterwards.
GSI_HOST=127.0.0.1
GSI_PORT=3080

# Optional shared secret. Set it and re-run gsi:install, and packets without a
# matching token are dropped. Only useful if GSI_HOST is not loopback.
GSI_TOKEN=

# How often Dota sends an update, and how long it may go quiet before the Bar
# falls back to the idle screen. Both are written into the .cfg by gsi:install.
GSI_THROTTLE_SEC=0.5
GSI_HEARTBEAT_SEC=10
GSI_STALE_MS=30000

# Your 64-bit Steam id, for the between-games screen (today's record, streak,
# rank, last game). Leave empty and it is learned from the first GSI packet.
# Find it on https://steamid.io or in your Dota 2 profile URL.
STEAM_ID=

# OpenDota is only polled between games, and never during one.
ACCOUNT_POLL_MS=300000

# Sounds fire on kills, deaths, streaks, buildings and the game starting or
# ending. Set to 0 to mute everything.
SOUNDS=1

# How a line too long for 72px is shown.
# page   — break on words and hold each chunk still (default; nothing to stutter)
# scroll — move the line like a news ticker
TICKER_STYLE=page

# Glyphs assumed to fit on one line of the 72px front display. The default is
# deliberately conservative (4px a glyph); if short lines page when they plainly
# had room to sit still, raise this until they stop.
TICKER_CHARS=17

FRAME_MS=200
REQUEST_TIMEOUT_MS=10000
DRAW_PRIORITY=40

# Only needed when gsi:install cannot find Dota 2 by itself.
# DOTA_PATH=D:/SteamLibrary/steamapps/common/dota 2 beta

# Set to 1 to run a synthetic game instead of listening for Dota (same as --demo).
DEMO=
