{
  "name": "busybar-mydota",
  "version": "1.0.0",
  "description": "Your own live Dota 2 game on BUSY Bar, via Game State Integration",
  "license": "MIT",
  "author": "viirtualp1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viirtualp1/busybar-mydota.git"
  },
  "bugs": {
    "url": "https://github.com/viirtualp1/busybar-mydota/issues"
  },
  "homepage": "https://github.com/viirtualp1/busybar-mydota#readme",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "busybar-mydota": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "keywords": [
    "dota2",
    "gsi",
    "game-state-integration",
    "busy-bar",
    "busybar",
    "led"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && busybar-fix-esm",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev": "tsx src/index.ts",
    "demo": "tsx src/index.ts --demo",
    "start": "npm run build && node dist/index.js",
    "shot": "tsx src/preview.ts",
    "gsi:install": "tsx src/gsi-install.ts",
    "gsi:check": "tsx src/gsi-check.ts",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@busy-app/busy-lib": "^0.18.0",
    "busybar-kit": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
